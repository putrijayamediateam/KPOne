  "wf-title": {
   "x": 0,
   "y": -300,
   "text": "New workflow proposal: registration to pharmacy (mock-up, fictional data)",
   "kind": "title1",
   "maxW": 5920,
   "page": "page-new-workflow"
  },
  "wf-n1": {
   "x": 0,
   "y": 1200,
   "w": 420,
   "text": "Vitals: the CA records them at the counter or waiting area. Not required for Call In; the doctor can enter them instead. Each reading shows who took it and when.",
   "fill": "orange",
   "page": "page-new-workflow"
  },
  "wf-n2": {
   "x": 1520,
   "y": 1200,
   "w": 420,
   "text": "Triage zones replace Normal/Urgent. Red alerts every doctor at the same branch; the first to press \"I'll take it\" stops the alert for the others. Zone criteria must be written and approved by a named doctor.",
   "fill": "orange",
   "page": "page-new-workflow"
  },
  "wf-n3": {
   "x": 3040,
   "y": 1200,
   "w": 420,
   "text": "Order sets come from the clinic's own formulary, approved by a clinic doctor. MIMS content can only be used under a MIMS licence (MIMS Integrated). A medicine outside the set needs the doctor's reason.",
   "fill": "orange",
   "page": "page-new-workflow"
  },
  "wf-n4": {
   "x": 4560,
   "y": 1200,
   "w": 420,
   "text": "Warn and confirm, never block: the CA sees the off-protocol flag and the doctor's reason before dispensing. Family history in consult is left out until the PDPA review.",
   "fill": "orange",
   "page": "page-new-workflow"
  }
