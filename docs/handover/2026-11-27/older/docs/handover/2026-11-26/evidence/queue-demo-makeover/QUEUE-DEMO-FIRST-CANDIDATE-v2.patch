@@ -0,0 +1,148 @@
+<script setup lang="ts">
+import { computed, ref } from 'vue';
+
+type Tab = {
+    value: 'all' | 'waiting' | 'serving' | 'removed';
+    label: string;
+    count?: number;
+};
+const props = defineProps<{
+    tabs: Tab[];
+    activeTab: Tab['value'];
+    scope: 'own' | 'branch';
+    branchName: string;
+    canRegistration: boolean;
+}>();
+defineEmits<{ select: [value: Tab['value']] }>();
+const showInfo = ref(true);
+const about = computed(
+    () =>
+        ({
+            all: 'Your active queue includes waiting and serving patients. Red-zone emergencies remain in their own lane.',
+            waiting:
+                'Red-zone emergencies remain in their own lane. Other patients are ordered by urgency, then arrival; today comes before carry-over.',
+            serving:
+                'Patients currently in consultation, including held consultations. Open the consultation to continue care or resume a held patient.',
+            removed:
+                'Completed consultations. The list shows the latest records; the count includes all matching completed entries.',
+        })[props.activeTab],
+);
+</script>
+
+<template>
+    <div
+        class="grid min-w-0 items-start gap-5"
+        :class="showInfo ? 'xl:grid-cols-[minmax(0,1fr)_280px]' : ''"
+        data-testid="queue-workspace-frame"
+    >
+        <div class="flex min-w-0 flex-col gap-4">
+            <div
+                class="grid grid-cols-2 gap-3 lg:grid-cols-4"
+                aria-label="Queue summary"
+            >
+                <button
+                    v-for="tab in tabs"
+                    :key="tab.value"
+                    type="button"
+                    :aria-pressed="activeTab === tab.value"
+                    class="min-h-24 rounded-2xl border bg-card p-4 text-left shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
+                    :class="
+                        activeTab === tab.value
+                            ? 'border-primary ring-1 ring-primary'
+                            : 'border-transparent hover:border-border'
+                    "
+                    @click="$emit('select', tab.value)"
+                >
+                    <span class="block text-2xl font-semibold tabular-nums">{{
+                        tab.count ?? '—'
+                    }}</span>
+                    <span class="mt-1 block text-xs text-muted-foreground">{{
+                        tab.label
+                    }}</span>
+                </button>
+            </div>
+            <div class="flex flex-wrap items-center justify-between gap-2">
+                <p class="text-xs text-muted-foreground">
+                    {{ scope === 'own' ? 'Your patients' : 'All doctors' }} ·
+                    {{ branchName }} · Live, every 3 seconds
+                </p>
+                <button
+                    type="button"
+                    class="min-h-11 rounded-full bg-muted px-4 text-xs lg:min-h-9"
+                    :aria-expanded="showInfo"
+                    aria-controls="queue-helpful-info"
+                    @click="showInfo = !showInfo"
+                >
+                    {{ showInfo ? 'Hide helpful info' : 'Show helpful info' }}
+                </button>
+            </div>
+            <slot />
+        </div>
+        <aside
+            v-if="showInfo"
+            id="queue-helpful-info"
+            class="grid min-w-0 gap-3"
+            aria-label="Helpful queue information"
+        >
+            <details open class="rounded-2xl bg-card p-4 shadow-sm">
+                <summary
+                    class="min-h-11 cursor-pointer text-sm font-semibold lg:min-h-9"
+                >
+                    About this tab
+                </summary>
+                <p class="text-xs leading-relaxed text-muted-foreground">
+                    {{ about }}
+                </p>
+                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
+                    Waiting turns amber from 30 minutes and red from 60 minutes.
+                </p>
+            </details>
+            <details open class="rounded-2xl bg-card p-4 shadow-sm">
+                <summary
+                    class="min-h-11 cursor-pointer text-sm font-semibold lg:min-h-9"
+                >
+                    Queue at a glance
+                </summary>
+                <dl class="text-xs">
+                    <div
+                        v-for="tab in tabs"
+                        :key="tab.value"
+                        class="flex justify-between gap-4 border-t py-3"
+                    >
+                        <dt>{{ tab.label }}</dt>
+                        <dd class="text-muted-foreground tabular-nums">
+                            {{ tab.count ?? '—' }}
+                        </dd>
+                    </div>
+                </dl>
+                <slot name="summary" />
+            </details>
+            <details class="rounded-2xl bg-card px-4 py-2 shadow-sm">
+                <summary
+                    class="min-h-11 cursor-pointer py-2 text-sm font-semibold lg:min-h-9"
+                >
+                    Related pages
+                </summary>
+                <a
+                    v-if="canRegistration"
+                    href="/registration"
+                    class="flex min-h-11 items-center border-t text-sm text-primary lg:min-h-9"
+                    >Visits today</a
+                >
+                <slot name="related" />
+            </details>
+            <details class="rounded-2xl bg-card px-4 py-2 shadow-sm">
+                <summary
+                    class="min-h-11 cursor-pointer py-2 text-sm font-semibold lg:min-h-9"
+                >
+                    Good to know
+                </summary>
+                <p class="pb-2 text-xs leading-relaxed text-muted-foreground">
+                    Calling a patient announces their queue number and room on
+                    the TV. Held consultations stay held when another patient is
+                    called. Check the patient's readiness before calling.
+                </p>
+            </details>
+        </aside>
+    </div>
+</template>
diff --git a/tests/Frontend/queue-demo-workspace.test.mjs b/tests/Frontend/queue-demo-workspace.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/Frontend/queue-demo-workspace.test.mjs
@@ -0,0 +1,186 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import test from 'node:test';
+import { runInNewContext } from 'node:vm';
+import { compileScript, parse } from '@vue/compiler-sfc';
+import { renderToString } from '@vue/server-renderer';
+import ts from 'typescript';
+import { createSSRApp } from 'vue';
+
+const require = createRequire(import.meta.url);
+const source = readFileSync(
+    'resources/js/components/queue/QueueWorkspaceFrame.vue',
+    'utf8',
+);
+const script = compileScript(parse(source).descriptor, {
+    id: 'calls-today',
+    inlineTemplate: true,
+}).content;
+const js = ts.transpileModule(script, {
+    compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2022,
+    },
+}).outputText;
+const module = { exports: {} };
+runInNewContext(js, { exports: module.exports, require });
+const render = (props = {}) =>
+    renderToString(
+        createSSRApp(module.exports.default, {
+            tabs: [
+                { value: 'waiting', label: 'Waiting', count: 27 },
+                { value: 'serving', label: 'Serving', count: 0 },
+            ],
+            activeTab: 'waiting',
+            scope: 'branch',
+            branchName: 'Synthetic branch',
+            canRegistration: false,
+            ...props,
+        }),
+    );
+
+test('workspace renders server totals rather than a loaded-row estimate and retains zero', async () => {
+    const html = await render();
+    assert.match(html, />27<\/span>/);
+    assert.match(html, />0<\/span>/);
+    assert.match(html, /aria-pressed="true"/);
+    assert.match(html, /Synthetic branch/);
+    assert.match(html, /About this tab/);
+    assert.match(html, /Red-zone emergencies remain in their own lane/);
+    assert.doesNotMatch(html, /href="\/registration"/);
+});
+test('own serving view changes context and help without exposing a branch directory link', async () => {
+    const html = await render({ scope: 'own', activeTab: 'serving' });
+    assert.match(html, /Your patients/);
+    assert.match(html, /Patients currently in consultation/);
+    assert.doesNotMatch(html, /Other patients are ordered/);
+    assert.doesNotMatch(html, /href="\/registration"/);
+});
+test('authorized registration link and absent counts remain explicit', async () => {
+    const html = await render({
+        canRegistration: true,
+        tabs: [{ value: 'waiting', label: 'Waiting' }],
+    });
+    assert.match(html, /href="\/registration"/);
+    assert.match(html, />—<\/span>/);
+    assert.match(html, /aria-controls="queue-helpful-info"/);
+});
+
+const Vue = require('vue');
+const passthrough = Vue.defineComponent({
+    setup:
+        (_, { slots }) =>
+        () =>
+            Vue.h('span', slots.default?.()),
+});
+const boardScript = compileScript(
+    parse(
+        readFileSync(
+            'resources/js/components/patient-board/PatientBoard.vue',
+            'utf8',
+        ),
+    ).descriptor,
+    { id: 'queue-board-mode', inlineTemplate: true },
+).content;
+const boardModule = { exports: {} };
+const waitingModule = { exports: {} };
+runInNewContext(
+    ts.transpileModule(
+        readFileSync('resources/js/lib/waiting-time.ts', 'utf8'),
+        { compilerOptions: { module: ts.ModuleKind.CommonJS } },
+    ).outputText,
+    { exports: waitingModule.exports, require },
+);
+runInNewContext(
+    ts.transpileModule(boardScript, {
+        compilerOptions: {
+            module: ts.ModuleKind.CommonJS,
+            target: ts.ScriptTarget.ES2022,
+        },
+    }).outputText,
+    {
+        exports: boardModule.exports,
+        require: (name) =>
+            name === 'vue'
+                ? Vue
+                : name === '@/lib/waiting-time'
+                  ? waitingModule.exports
+                  : new Proxy(
+                        {},
+                        {
+                            get: (_, key) =>
+                                key === 'router' ? {} : passthrough,
+                        },
+                    ),
+    },
+);
+const board = (queueLayout) =>
+    renderToString(
+        createSSRApp(boardModule.exports.default, {
+            queueLayout,
+            rows: [
+                {
+                    key: 'synthetic',
+                    patientName: 'Synthetic Patient',
+                    patientNumber: 'KP-00000001',
+                    queueNumber: 'A-001',
+                    coverageLabel: 'Synthetic coverage',
+                    doctorName: 'Synthetic Doctor',
+                    durationLabel: '5 min',
+                    statusLabel: 'Waiting',
+                    visitNotes: 'Synthetic reason',
+                    can: {},
+                    actions: {},
+                    triage: null,
+                },
+            ],
+        }),
+    );
+test('queue presentation uses focused columns while default Registration retains its original columns', async () => {
+    const own = await board('own');
+    const branch = await board('branch');
+    const registration = await board(undefined);
+    assert.doesNotMatch(own, /data-label="(?:Arrived|Payment|Doctor)"/);
+    assert.match(branch, /data-label="Doctor"/);
+    assert.doesNotMatch(branch, /data-label="(?:Arrived|Payment)"/);
+
+    for (const field of ['Arrived', 'Payment', 'Doctor']) {
+        assert.match(registration, new RegExp(`data-label="${field}"`));
+    }
+
+    for (const html of [own, branch, registration]) {
+        assert.match(html, /Synthetic Patient/);
+        assert.match(html, /A-001/);
+    }
+
+    assert.match(own, /No\.<\/th>/);
+    assert.match(own, /Reason<\/th>/);
+});
+
+test('changing branch or losing branch-wide view leaves the Doctors section', async () => {
+    const pageSource = readFileSync(
+        'resources/js/pages/Queue/Index.vue',
+        'utf8',
+    );
+    const callback = pageSource.match(
+        /watch\(\s*\[\(\) => live\.value\.branch\.id, \(\) => live\.value\.scope\],[\s\S]*?\n\}\);/,
+    )[0];
+    const live = Vue.ref({ branch: { id: 1 }, scope: 'branch' });
+    const workspaceSection = Vue.ref('doctors');
+    const stop = runInNewContext(callback.replace(/;$/, ''), {
+        watch: Vue.watch,
+        live,
+        workspaceSection,
+    });
+    live.value.scope = 'own';
+    await Vue.nextTick();
+    assert.equal(workspaceSection.value, 'queue');
+    live.value.scope = 'branch';
+    await Vue.nextTick();
+    workspaceSection.value = 'doctors';
+    live.value.branch.id = 2;
+    await Vue.nextTick();
+    assert.equal(workspaceSection.value, 'queue');
+    stop();
+});
