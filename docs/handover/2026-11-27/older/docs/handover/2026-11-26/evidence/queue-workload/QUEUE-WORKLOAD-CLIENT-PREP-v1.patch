--- /dev/null
+++ b/resources/js/composables/useQueueWorkload.ts
@@ -0,0 +1,98 @@
+import { ref } from 'vue';
+import { requestJson } from '@/lib/json-client';
+import type { QueueRow } from '@/types/queue';
+
+export type QueueWorkloadSection = 'held' | 'treatment' | 'checks';
+export type QueueWorkloadPage = {
+    branchId: number;
+    scope: 'own' | 'branch';
+    section: QueueWorkloadSection;
+    serverNow: string;
+    data: QueueRow[];
+    total: number;
+    currentPage: number;
+    lastPage: number;
+    perPage: number;
+};
+
+/** Optional private list request. Its caller must not await it in the main Queue refresh loop. */
+export function useQueueWorkload() {
+    const page = ref<QueueWorkloadPage | null>(null);
+    const loading = ref(false);
+    const unavailable = ref(false);
+    let selection: string | null = null;
+    let sequence = 0;
+    let active: AbortController | null = null;
+
+    const reset = () => {
+        sequence += 1;
+        active?.abort();
+        active = null;
+        selection = null;
+        page.value = null;
+        loading.value = false;
+        unavailable.value = false;
+    };
+    const poll = async (
+        branchId: number,
+        section: QueueWorkloadSection,
+        requestedPage: number,
+        parentSignal: AbortSignal,
+        accepts: () => boolean = () => true,
+    ) => {
+        const key = `${branchId}:${section}:${requestedPage}`;
+
+        if (selection !== key) {
+            reset();
+            selection = key;
+        }
+
+        const current = ++sequence;
+        active?.abort();
+        const request = new AbortController();
+        active = request;
+        loading.value = true;
+        const abort = () => request.abort();
+        parentSignal.addEventListener('abort', abort, { once: true });
+
+        if (parentSignal.aborted) {
+            abort();
+        }
+
+        const publish = () =>
+            current === sequence && !request.signal.aborted && accepts();
+
+        try {
+            const response = await requestJson<QueueWorkloadPage>(
+                `/queue/workload?expected_branch_id=${branchId}&section=${section}&page=${requestedPage}`,
+                { signal: request.signal },
+            );
+
+            if (publish()) {
+                if (
+                    response.branchId !== branchId ||
+                    response.section !== section
+                ) {
+                    throw new Error('Queue workload response scope changed.');
+                }
+
+                page.value = response;
+                unavailable.value = false;
+            }
+        } catch {
+            if (publish()) {
+                page.value = null;
+                unavailable.value = true;
+            }
+        } finally {
+            parentSignal.removeEventListener('abort', abort);
+
+            if (active === request) {
+                active = null;
+                loading.value = false;
+            }
+        }
+    };
+
+    return { page, loading, unavailable, poll, reset };
+}
diff --git a/tests/Frontend/queue-workload.test.mjs b/tests/Frontend/queue-workload.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/Frontend/queue-workload.test.mjs
@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import test from 'node:test';
+import { runInNewContext } from 'node:vm';
+import ts from 'typescript';
+
+const require = createRequire(import.meta.url);
+const harness = () => {
+    const pending = [];
+    const exports = {};
+    const js = ts.transpileModule(
+        readFileSync('resources/js/composables/useQueueWorkload.ts', 'utf8'),
+        {
+            compilerOptions: {
+                module: ts.ModuleKind.CommonJS,
+                target: ts.ScriptTarget.ES2022,
+            },
+        },
+    ).outputText;
+    runInNewContext(js, {
+        exports,
+        AbortController,
+        require: (name) =>
+            name === '@/lib/json-client'
+                ? {
+                      requestJson: (url, init) =>
+                          new Promise((resolve, reject) =>
+                              pending.push({ url, init, resolve, reject }),
+                          ),
+                  }
+                : require(name),
+    });
+
+    return { model: exports.useQueueWorkload(), pending };
+};
+const response = (branchId = 1, section = 'held', currentPage = 1) => ({
+    branchId,
+    section,
+    currentPage,
+    data: [],
+    total: 0,
+    lastPage: 1,
+    perPage: 25,
+});
+
+test('switching branch, section or page aborts the old list and discards late results', async () => {
+    const { model, pending } = harness();
+    const signal = new AbortController().signal;
+    const old = model.poll(1, 'held', 1, signal);
+    const fresh = model.poll(2, 'treatment', 2, signal);
+    assert.equal(pending[0].init.signal.aborted, true);
+    assert.equal(
+        pending[1].url,
+        '/queue/workload?expected_branch_id=2&section=treatment&page=2',
+    );
+    pending[1].resolve(response(2, 'treatment', 1));
+    await fresh;
+    pending[0].resolve(response());
+    await old;
+    assert.equal(model.page.value.branchId, 2);
+    assert.equal(
+        model.page.value.currentPage,
+        1,
+        'Server-clamped page is authoritative.',
+    );
+    const changedPage = model.poll(2, 'treatment', 3, signal);
+    assert.equal(
+        model.page.value,
+        null,
+        'Never show another page while it is loading.',
+    );
+    model.reset();
+    pending[2].resolve(response(2, 'treatment', 3));
+    await changedPage;
+    assert.equal(model.page.value, null);
+    assert.equal(model.loading.value, false);
+});
+
+test('a failed refresh removes stale actionable rows and rejects mismatched response scope', async () => {
+    const { model, pending } = harness();
+    const signal = new AbortController().signal;
+    const first = model.poll(1, 'held', 1, signal);
+    pending[0].resolve(response());
+    await first;
+    const failed = model.poll(1, 'held', 1, signal);
+    pending[1].reject(new Error('network'));
+    await failed;
+    assert.equal(model.page.value, null);
+    assert.equal(model.unavailable.value, true);
+    const wrong = model.poll(1, 'held', 1, signal);
+    pending[2].resolve(response(2));
+    await wrong;
+    assert.equal(model.page.value, null);
+    assert.equal(model.unavailable.value, true);
+});
+
+test('parent abort and generation guard prevent publication without waiting for a hung optional request', async () => {
+    const { model, pending } = harness();
+    const parent = new AbortController();
+    let accepted = true;
+    const first = model.poll(1, 'held', 1, parent.signal, () => accepted);
+    assert.equal(model.loading.value, true);
+    accepted = false;
+    pending[0].resolve(response());
+    await first;
+    assert.equal(model.page.value, null);
+    const next = model.poll(1, 'checks', 1, parent.signal);
+    parent.abort();
+    assert.equal(pending[1].init.signal.aborted, true);
+    pending[1].resolve(response(1, 'checks'));
+    await next;
+    assert.equal(model.page.value, null);
+    assert.equal(model.unavailable.value, false);
+});
