+                            <dt class="text-xs text-muted-foreground">
+                                Branch
+                            </dt>
+                            <dd class="mt-1 break-words">{{ row.branch }}</dd>
+                        </div>
+                        <div>
+                            <dt class="text-xs text-muted-foreground">
+                                Location type
+                            </dt>
+                            <dd class="mt-1 break-words">
+                                {{ row.locationType }}
+                            </dd>
+                        </div>
+                        <div>
+                            <dt class="text-xs text-muted-foreground">
