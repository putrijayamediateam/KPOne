{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(//c/Users/User/Herd/**/.env)",
      "Read(//c/Users/User/Herd/KPOne-*UAT*/**)",
      "Edit(//c/Users/User/Herd/KPOne-*UAT*/**)",
      "Read(//c/Users/User/Herd/KPOne-*Secrets*/**)",
      "Edit(//c/Users/User/Herd/KPOne-*Secrets*/**)",
      "Edit(//c/Users/User/Herd/KPOne-*Evidence*/**)",
      "Edit(//c/Users/User/Herd/KPOne-Preview*/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(php artisan db:wipe*)",
      "Bash(php artisan migrate:reset*)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git tag*)",
      "Bash(gh pr*)",
      "Bash(gh release*)",
      "Bash(gh workflow run*)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:rollback*)",
      "Bash(composer require*)",
      "Bash(composer update*)",
      "Bash(composer remove*)",
      "Bash(npm install *)",
      "Bash(npm update*)",
      "Bash(npm uninstall*)",
      "Bash(npm audit fix*)",
      "Bash(pnpm add*)",
      "Bash(pnpm update*)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git commit *)"
    ],
    "allow": [
      "Read(.env.example)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge origin/main*)",
      "Bash(git merge --no-edit origin/main*)",
      "Bash(git merge --no-ff origin/main*)",
      "Bash(git merge --no-ff --no-edit origin/main*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin validation/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push --set-upstream origin feature/*)",
      "Bash(git push --set-upstream origin fix/*)",
      "Bash(git push --set-upstream origin docs/*)",
      "Bash(git push --set-upstream origin validation/*)",
      "Bash(git push --set-upstream origin claude/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin validation/*)",
      "Bash(git push origin claude/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
