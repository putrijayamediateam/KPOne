<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Billing/PostgresPanelPaymentRegressionTest.php</exclude>
            <exclude>tests/Feature/Billing/PostgresPanelBulkClaimRegressionTest.php</exclude>
            <exclude>tests/Feature/Clinical/PostgresDispensaryReturnTest.php</exclude>
            <exclude>tests/Feature/Clinical/PostgresDrugLabelPrintTest.php</exclude>
            <exclude>tests/Feature/HR/PostgresRosterContentionTest.php</exclude>
            <exclude>tests/Feature/HR/PostgresLeaveContentionTest.php</exclude>
            <exclude>tests/Feature/HR/PostgresAttendanceContentionTest.php</exclude>
            <exclude>tests/Feature/HR/PostgresOvertimeContentionTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresBatchHoldTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresGovernedStockTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresStockReadinessTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresSupplierReturnTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresTransferShortageTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresTreatmentUsageTest.php</exclude>
            <exclude>tests/Feature/Inventory/PostgresVerifiedReceivingTest.php</exclude>
            <exclude>tests/Feature/Patient/PostgresPatientMergeRegressionTest.php</exclude>
            <exclude>tests/Feature/PilotStorageIsolationTest.php</exclude>
            <exclude>tests/Feature/PostgresAttendanceNumberTest.php</exclude>
            <exclude>tests/Feature/PostgresBillingRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresBranchAssignmentRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresBusinessDetailsRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresCashClosingRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresClinicalEncounterRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresClinicalSafetyRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresDispensaryInventoryRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresPatientMasterRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresQueueRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresReferralNumberTest.php</exclude>
            <exclude>tests/Feature/PostgresTreatmentPlanRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresVisitReasonRegressionTest.php</exclude>
            <exclude>tests/Feature/PostgresVisitRegistrationRegressionTest.php</exclude>
            <exclude>tests/Feature/Queue/CallReadinessConcurrencyTest.php</exclude>
            <exclude>tests/Feature/Website/WebsiteOutputPlanTest.php</exclude>
            <exclude>tests/Feature/Website/WebsiteReleaseTest.php</exclude>
        </testsuite>
        <!-- CI-PAR-1: tests that start a process (worker subprocesses connect to the configured test database; a forked
             child shares the parent's storage). They run in their own serial CI step; ContentionSuiteTest fails if a
             test that starts a process is missing here. Order does not matter: TestCase restores the unseeded
             schema when seeded role grants were left committed. -->
        <testsuite name="Contention">
            <file>tests/Feature/Billing/PostgresPanelPaymentRegressionTest.php</file>
            <file>tests/Feature/Billing/PostgresPanelBulkClaimRegressionTest.php</file>
            <file>tests/Feature/Clinical/PostgresDispensaryReturnTest.php</file>
            <file>tests/Feature/Clinical/PostgresDrugLabelPrintTest.php</file>
            <file>tests/Feature/HR/PostgresRosterContentionTest.php</file>
            <file>tests/Feature/HR/PostgresLeaveContentionTest.php</file>
            <file>tests/Feature/HR/PostgresAttendanceContentionTest.php</file>
            <file>tests/Feature/HR/PostgresOvertimeContentionTest.php</file>
            <file>tests/Feature/Inventory/PostgresBatchHoldTest.php</file>
            <file>tests/Feature/Inventory/PostgresGovernedStockTest.php</file>
            <file>tests/Feature/Inventory/PostgresStockReadinessTest.php</file>
            <file>tests/Feature/Inventory/PostgresSupplierReturnTest.php</file>
            <file>tests/Feature/Inventory/PostgresTransferShortageTest.php</file>
            <file>tests/Feature/Inventory/PostgresTreatmentUsageTest.php</file>
            <file>tests/Feature/Inventory/PostgresVerifiedReceivingTest.php</file>
            <file>tests/Feature/Patient/PostgresPatientMergeRegressionTest.php</file>
            <file>tests/Feature/PilotStorageIsolationTest.php</file>
            <file>tests/Feature/PostgresAttendanceNumberTest.php</file>
            <file>tests/Feature/PostgresBillingRegressionTest.php</file>
            <file>tests/Feature/PostgresBranchAssignmentRegressionTest.php</file>
            <file>tests/Feature/PostgresBusinessDetailsRegressionTest.php</file>
            <file>tests/Feature/PostgresCashClosingRegressionTest.php</file>
            <file>tests/Feature/PostgresClinicalEncounterRegressionTest.php</file>
            <file>tests/Feature/PostgresClinicalSafetyRegressionTest.php</file>
            <file>tests/Feature/PostgresDispensaryInventoryRegressionTest.php</file>
            <file>tests/Feature/PostgresPatientMasterRegressionTest.php</file>
            <file>tests/Feature/PostgresQueueRegressionTest.php</file>
            <file>tests/Feature/PostgresReferralNumberTest.php</file>
            <file>tests/Feature/PostgresTreatmentPlanRegressionTest.php</file>
            <file>tests/Feature/PostgresVisitReasonRegressionTest.php</file>
            <file>tests/Feature/PostgresVisitRegistrationRegressionTest.php</file>
            <file>tests/Feature/Queue/CallReadinessConcurrencyTest.php</file>
            <file>tests/Feature/Website/WebsiteOutputPlanTest.php</file>
            <file>tests/Feature/Website/WebsiteReleaseTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="PUBLIC_PATIENT_INTAKE_ENABLED" value="true" force="true"/>
        <server name="PUBLIC_PATIENT_INTAKE_ENABLED" value="true"/>
    </php>
</phpunit>
