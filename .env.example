APP_NAME=KPOne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

PUBLIC_PATIENT_INTAKE_ENABLED=false
PUBLIC_PATIENT_INTAKE_MINOR_AGE=18
PUBLIC_PATIENT_INTAKE_LINK_TTL_DAYS=90
PUBLIC_PATIENT_INTAKE_SESSION_TTL_MINUTES=15
PUBLIC_PATIENT_INTAKE_TRUSTED_PROXIES=
HR_APPLICATIONS_ENABLED=false
HR_APPLICATIONS_PRIVACY_NOTICE_VERSION=
HR_MESSAGES_EMAIL_ENABLED=false
HR_HIRING_EMAIL_ENABLED=false
HR_HIRING_MAILBOX=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kpone
DB_USERNAME=kpone
DB_PASSWORD=replace-with-a-strong-local-password
DB_SSLMODE=prefer
# KPOne stores every time in UTC. Keep this UTC, whatever the database server's own time zone is.
DB_TIMEZONE=UTC

# Ask KPOne (AG-7): separate read-only login for the masked ai_read views. Create it once; see docs/DEVELOPMENT.md.
AI_READER_DB_USERNAME=kpone_ai_reader
AI_READER_DB_PASSWORD=replace-with-a-different-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Approval that prepares work (docs/agents/CONTRACT.md section 15). Leave false until the owner decides.
AGENTS_PREPARE_ENABLED=false

# The KPOne connector (docs/agents/MCP-CONNECTOR-DESIGN.md). OFF by default: the MCP and OAuth routes answer 404. Only the
# person who manages the server environment turns it on, only on a server with fictional data until the privacy review.
AGENTS_CONNECTOR_ENABLED=false
# Redirect origins the connector app may register, comma separated, each ending in a slash (config/mcp.php has the defaults).
# MCP_REDIRECT_DOMAINS=https://claude.ai/,https://claude.com/
# OAuth signing keys (created with `php artisan passport:keys`, or set here); never real values in this file.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
